<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Quotation lines for books are booked on this service product, priced from the book. -->
    <record id="library_quotation_item" model="product.template">
        <field name="name">Library Quotation Item</field>
        <field name="default_code">LIBRARY_QUOTATION_ITEM</field>
        <field name="detailed_type">service</field>
        <field name="sale_ok" eval="True"/>
        <field name="purchase_ok" eval="False"/>
        <field name="list_price">0.0</field>
    </record>
</odoo>
